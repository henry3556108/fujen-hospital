{
  "realm": "ai-platform",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "ai-platform-importer",
      "description": "批次影像匯入 CLI：device-code 登入；directAccessGrants 只為本機驗收，正式環境關閉",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ai-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ai-platform-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "${WEB_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "${WEB_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ai-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ai-platform-api",
      "publicClient": false,
      "secret": "${KC_API_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "ai-platform-ohif",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${OHIF_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "${OHIF_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${OHIF_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ai-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin01",
      "enabled": true,
      "email": "admin01@example.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_ADMIN01_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-ai-platform-api",
      "enabled": true,
      "serviceAccountClientId": "ai-platform-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
